@page "/"
@model IndexModel
@{
    var picks = Model.HeroPicks.Where(p => p.Client.Cover is not null).ToList();
    var marquee = Model.Items.Select(i => i.Client.FullName).Distinct().Take(16).ToList();
}

<section class="hero">
    <div class="container hero__grid">
        <div class="hero__copy">
            <p class="hero__eyebrow intro" style="--d:0">
                <span class="pulse" aria-hidden="true"></span> @Model.Site.Tagline
            </p>
            <h1 class="hero__title">@Display.AnimatedTitle(Model.Site.HeroTitle)</h1>
            <p class="hero__lead intro" style="--d:5">@Model.Site.HeroSubtitle</p>
            <button type="button" class="hero-search intro" style="--d:6" data-search-open aria-label="Search clients by name">
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <span class="hero-search__text">Search clients by name…</span>
                <span class="hero-search__go" aria-hidden="true"><svg class="icon"><use href="#i-arrow-right" /></svg></span>
            </button>
            <div class="hero__actions intro" style="--d:7">
                <a class="btn btn--dark btn--lg" href="#roster" data-magnetic>
                    Explore the roster <span class="btn__arrow"><svg class="icon"><use href="#i-arrow-right" /></svg></span>
                </a>
                @if (Model.Spotlight.Count > 0)
                {
                    <a class="btn btn--ghost btn--lg" href="#spotlight">See the top three</a>
                }
            </div>
            <dl class="hero__stats intro" style="--d:8">
                <div><dt>Clients</dt><dd data-count="@Model.Stats.Clients">@Model.Stats.Clients</dd></div>
                <div><dt>Projects</dt><dd data-count="@Model.Stats.Projects">@Model.Stats.Projects</dd></div>
                <div><dt>Ranking</dt><dd>By hand</dd></div>
            </dl>
        </div>

        <div class="hero__visual" data-parallax aria-hidden="@(picks.Count == 0 ? "true" : null)">
            <div class="hero__glow"></div>
            @if (picks.Count == 0)
            {
                <div class="collage collage--empty">
                    <div class="collage__card collage__card--1"><span class="collage__mono">@Display.Monogram(Model.Site.SiteName)</span></div>
                </div>
            }
            else
            {
                <div class="collage collage--@picks.Count">
                    @for (var i = 0; i < picks.Count; i++)
                    {
                        var p = picks[i];
                        <a class="collage__card collage__card--@(i + 1)" href="@Url.Page("/Client", new { slug = p.Client.Slug })" data-depth="@(i == 0 ? "1" : i == 1 ? "1.8" : "2.4")">
                            <img src="@p.Client.Cover!.ThumbUrl" alt="@p.Client.FullName" data-fade loading="eager" />
                            <span class="collage__tag">
                                <b>@Display.Rank(p.Rank)</b>
                                <span dir="auto">@p.Client.FullName</span>
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</section>

@if (marquee.Count >= 3)
{
    <div class="marquee" aria-hidden="true">
        <div class="marquee__track">
            @for (var pass = 0; pass < 2; pass++)
            {
                foreach (var name in marquee)
                {
                    <span class="marquee__item" dir="auto">@name</span>
                    <span class="marquee__star">✦</span>
                }
            }
        </div>
    </div>
}

@if (Model.Spotlight.Count > 0)
{
    <section class="section spotlight" id="spotlight" aria-labelledby="spotlight-title">
        <div class="container">
            <header class="section-head reveal">
                <div>
                    <p class="kicker">In the spotlight</p>
                    <h2 class="section-head__title" id="spotlight-title">Top of the <em>roster</em></h2>
                </div>
                <p class="section-head__aside">Our first three — placed at the very top, by hand.</p>
            </header>
            <div class="spot-grid">
                @foreach (var item in Model.Spotlight)
                {
                    <partial name="_ClientCard" model="(item, true, true)" />
                }
            </div>
            <p class="spot-hint" aria-hidden="true">Swipe for more <svg class="icon"><use href="#i-arrow-right" /></svg></p>
        </div>
    </section>
}

<section class="section roster" id="roster" aria-labelledby="roster-title">
    <div class="container">
        <header class="section-head reveal">
            <div>
                <p class="kicker">@(Model.IsFiltered ? "Search" : "The roster")</p>
                <h2 class="section-head__title" id="roster-title">
                    @if (Model.IsFiltered)
                    {
                        <text>Results for <em>“@Model.Search”</em></text>
                    }
                    else
                    {
                        <text>Every face, <em>hand-placed</em></text>
                    }
                </h2>
            </div>
            <form class="search" method="get" action="/#roster" role="search">
                <svg class="icon search__icon" aria-hidden="true"><use href="#i-search" /></svg>
                <label class="visually-hidden" for="q">Search clients</label>
                <input id="q" name="q" type="search" value="@Model.Search" placeholder="Search name, role or city" maxlength="100" autocomplete="off" />
                @if (Model.IsFiltered)
                {
                    <a class="search__clear" href="/#roster" aria-label="Clear search"><svg class="icon"><use href="#i-close" /></svg></a>
                }
                else
                {
                    <kbd class="search__kbd" aria-hidden="true">/</kbd>
                }
            </form>
        </header>

        @if (Model.Items.Count == 0)
        {
            <div class="empty reveal">
                <span class="empty__mark" aria-hidden="true">✦</span>
                @if (!Model.IsFiltered)
                {
                    <h3>The roster is being curated.</h3>
                    <p>New profiles will appear here soon.</p>
                }
                else
                {
                    <h3>No one matches “@Model.Search”.</h3>
                    <p><a class="text-link" href="/#roster">Browse the full roster</a></p>
                }
            </div>
        }
        else
        {
            @if (Model.Rest.Count > 0)
            {
                <div class="grid">
                    @for (var i = 0; i < Model.Rest.Count; i++)
                    {
                        <partial name="_ClientCard" model="(Model.Rest[i], false, i < 4)" />
                    }
                </div>
            }
            else
            {
                <p class="roster__note reveal">That's everyone on the roster for now — see the spotlight above.</p>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="pager" aria-label="Pages">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="btn btn--ghost" href="@Model.PageUrl(Model.PageNumber - 1)"><svg class="icon"><use href="#i-arrow-left" /></svg> Previous</a>
                    }
                    <span class="pager__status">Page @Model.PageNumber of @Model.TotalPages</span>
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="btn btn--ghost" href="@Model.PageUrl(Model.PageNumber + 1)">Next <svg class="icon"><use href="#i-arrow-right" /></svg></a>
                    }
                </nav>
            }
        }
    </div>
</section>
